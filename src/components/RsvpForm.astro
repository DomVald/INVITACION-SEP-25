---

<section
  class="w-full bgx-primary py-10 flex flex-col items-center text-center relative"
>
  <h2 class="text-2xl font-serif block txt-complementary mb-6">
    Confirmar asistencia
  </h2>

  <form
    id="rsvpForm"
    class="w-3/4 max-w-md flex flex-col space-y-4 txt-secondary font-serif"
  >
    <!-- Botón confirmar -->
    <button
      type="submit"
      class="bgx-complementary block text-white font-medium py-3 px-6 rounded-full shadow-md hover:bg-[#8b3e1e] transition mt-4 mb-4"
    >
      Confirmar asistencia
    </button>
    <button
      type="button"
      class="bg-[#25D366] flex items-center justify-center gap-2 text-white font-medium py-3 px-6 rounded-full shadow-md hover:bg-[#128C7E] transition mt-4 mb-18"
      onclick="window.open('https://wa.me/+522291877765?text=hola,%20confirmo%20mi%20asistencia%20para%20la%20boda', '_blank'); let textSpan = this.querySelector('.button-text'); textSpan.innerHTML = 'Enviando <span style=&quot;color: white;&quot;>✅</span>'; setTimeout(() => { textSpan.innerHTML = 'Escríbenos un mensaje'; }, 2000);"
    >
      <img
        src="/whats logo.svg"
        alt="WhatsApp"
        width="20"
        height="20"
        class="text-white"
      />
      <span class="button-text">Escríbenos un mensaje</span>
    </button>
  </form>
</section>
